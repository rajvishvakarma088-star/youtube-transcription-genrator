BACKEND_SHARED_SECRET=replace-with-a-random-secret
MEDIA_TEMP_DIR=/tmp/media
MEDIA_TTL_SECONDS=3600
MEDIA_WORKERS=2
MEDIA_QUEUE=20
# Optional R2. Set all values and bind the same bucket as MEDIA_BUCKET in Wrangler.
# R2_BUCKET=private-media-bucket
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
